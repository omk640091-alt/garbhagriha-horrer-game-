rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. UserProgress Validation Blueprint
    function isValidUserProgress(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
             data.sanctumsCleansed is int && data.sanctumsCleansed >= 0 && data.sanctumsCleansed <= 10000 &&
             data.diyasLit is int && data.diyasLit >= 0 && data.diyasLit <= 100000 &&
             data.puzzlesSolved is int && data.puzzlesSolved >= 0 && data.puzzlesSolved <= 100000 &&
             data.highestSurvivalSec is int && data.highestSurvivalSec >= 0 && data.highestSurvivalSec <= 86400 &&
             data.unlockedCodexIds is list && data.unlockedCodexIds.size() <= 25 &&
             (data.unlockedCodexIds.size() == 0 || (data.unlockedCodexIds[0] is string && data.unlockedCodexIds[0].size() <= 64)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'sanctumsCleansed', 'diyasLit',
                         'puzzlesSolved', 'highestSurvivalSec', 'unlockedCodexIds',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'sanctumsCleansed', 'diyasLit',
                         'puzzlesSolved', 'highestSurvivalSec', 'unlockedCodexIds',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProgress(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProgress(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'sanctumsCleansed', 'diyasLit',
                         'puzzlesSolved', 'highestSurvivalSec', 'unlockedCodexIds',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 2. ExpeditionRoom Validation Blueprint
    function isValidExpeditionRoom(data) {
      return data.roomCode is string && data.roomCode.size() == 6 && data.roomCode.matches('^[A-Z0-9]+$') &&
             data.templeId is string && data.templeId in ['brihadeeswarar', 'konark', 'kailasa', 'bhangarh'] &&
             data.templeName is string && data.templeName.size() >= 3 && data.templeName.size() <= 80 &&
             data.entityName is string && data.entityName.size() >= 3 && data.entityName.size() <= 80 &&
             data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 50 &&
             data.status is string && data.status in ['waiting', 'active', 'escaped', 'consumed'] &&
             data.diyasLitCount is int && data.diyasLitCount >= 0 && data.diyasLitCount <= 10 &&
             data.sealsUnlocked is int && data.sealsUnlocked >= 0 && data.sealsUnlocked <= 10 &&
             (data.entityX is int || data.entityX is float) &&
             (data.entityY is int || data.entityY is float) &&
             data.entityAlertLevel is int && data.entityAlertLevel >= 0 && data.entityAlertLevel <= 100 &&
             data.lastRitualEvent is string && data.lastRitualEvent.size() <= 160 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 4 &&
             data.memberUids[0] is string && data.memberUids[0].size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /expedition_rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId) &&
                    (resource.data.status == 'waiting' || request.auth.uid in resource.data.memberUids);
      allow list: if isSignedIn() &&
                     (resource.data.status == 'waiting' || request.auth.uid in resource.data.memberUids);

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().hostUid == request.auth.uid &&
                       incoming().status == 'waiting' &&
                       request.auth.uid in incoming().memberUids &&
                       incoming().keys().hasAll([
                         'roomCode', 'templeId', 'templeName', 'entityName',
                         'hostUid', 'hostName', 'status', 'diyasLitCount',
                         'sealsUnlocked', 'entityX', 'entityY', 'entityAlertLevel',
                         'lastRitualEvent', 'memberUids', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'roomCode', 'templeId', 'templeName', 'entityName',
                         'hostUid', 'hostName', 'status', 'diyasLitCount',
                         'sealsUnlocked', 'entityX', 'entityY', 'entityAlertLevel',
                         'lastRitualEvent', 'memberUids', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidExpeditionRoom(incoming());

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidExpeditionRoom(incoming()) &&
                       existing().status in ['waiting', 'active'] &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().templeId == existing().templeId &&
                       incoming().templeName == existing().templeName &&
                       incoming().entityName == existing().entityName &&
                       incoming().hostUid == existing().hostUid &&
                       incoming().hostName == existing().hostName &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Join waiting room
                         (existing().status == 'waiting' &&
                          request.auth.uid in incoming().memberUids &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'lastRitualEvent', 'updatedAt'])) ||
                         // Action 2: Gameplay & ritual sync by room members
                         (request.auth.uid in existing().memberUids &&
                          request.auth.uid in incoming().memberUids &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'diyasLitCount', 'sealsUnlocked',
                            'entityX', 'entityY', 'entityAlertLevel',
                            'lastRitualEvent', 'memberUids', 'updatedAt'
                          ]))
                       );

      allow delete: if isSignedIn() && isValidId(roomId) && existing().hostUid == request.auth.uid;

      // 3. PlayerPresence Subcollection
      function isValidPlayerPresence(data) {
        return data.userId is string && data.userId == request.auth.uid &&
               data.roomCode is string && data.roomCode.size() == 6 &&
               data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
               (data.x is int || data.x is float) &&
               (data.y is int || data.y is float) &&
               (data.angle is int || data.angle is float) &&
               data.prana is int && data.prana >= 0 && data.prana <= 100 &&
               data.diyaLit is bool &&
               data.chantingMantra is bool &&
               data.updatedAt is timestamp && data.updatedAt <= request.time;
      }

      match /players/{playerId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(playerId) && resource.data.roomCode == roomId;
        allow list: if isSignedIn() && resource.data.roomCode is string;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         request.auth.uid == playerId &&
                         incoming().roomCode == roomId &&
                         incoming().keys().hasAll([
                           'userId', 'roomCode', 'displayName', 'x', 'y', 'angle',
                           'prana', 'diyaLit', 'chantingMantra', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'roomCode', 'displayName', 'x', 'y', 'angle',
                           'prana', 'diyaLit', 'chantingMantra', 'updatedAt'
                         ]) &&
                         isValidPlayerPresence(incoming());

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         request.auth.uid == playerId &&
                         isValidPlayerPresence(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().roomCode == existing().roomCode &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName', 'x', 'y', 'angle',
                           'prana', 'diyaLit', 'chantingMantra', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(playerId) && request.auth.uid == playerId;
      }
    }
  }
}
